# Environment Variables Setup
# Copy this file to .env.local and populate your keys when ready

# -----------------------------------------------------------------------------
# SUPABASE DATABASE
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# -----------------------------------------------------------------------------
# RAZORPAY PAYMENT GATEWAY (SANDBOX / LIVE)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# -----------------------------------------------------------------------------
# RESEND EMAIL SERVICE (FOR 80G PDF RECEIPTS & CSR LEADS)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_123456789_your_resend_api_key
NGO_ADMIN_EMAIL=admin@jeevandhara.org
SENDER_EMAIL=donations@jeevandhara.org

# -----------------------------------------------------------------------------
# APP CONFIG
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
